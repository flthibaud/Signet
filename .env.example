# Environment variables for application
PORT=8000

# Environment name. Leave it commented out for a real install: docker-compose.yml
# defaults it to `production`, and setting it here overrides that. `production`
# marks the auth cookie Secure unconditionally — otherwise the flag is set only
# when the request itself arrives over HTTPS.
# ENV="development"

# Database connection string.
DATABASE_URL="postgres://signet:signet@db:5432/signet?sslmode=disable"
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=25
DATABASE_MAX_IDLE_TIME="15m"

# Apply pending migrations on startup. On by default, so a fresh install only
# needs DATABASE_URL. Set to false to advance the schema yourself instead, with
# `./api --migrate-only` or the `make migrate-*` targets — worth doing if you
# run more than one instance and deploy them in a rolling fashion.
AUTO_MIGRATE=true

# Feed sync: poll period, worker pool size, feeds claimed per tick.
SCHEDULER_INTERVAL="15m"
SCHEDULER_WORKERS=5
SCHEDULER_BATCH_SIZE=50

# Session idle timeout. The expiry slides forward while the session is in use,
# so this is how long a session survives untouched, not how often you re-login.
SESSION_TTL="720h"

# Whether anyone can create an account. Closed by default: an instance exposed
# to the internet should not accept accounts you did not ask for. The very first
# account is always allowed — as long as the database has no user, so that a
# fresh install is not locked out of itself — after which the door shuts. Set to
# true to open it to other people.
REGISTRATION_ENABLED=false

# Rate limiter settings
RATE_LIMITER_RPS=5
RATE_LIMITER_BURST=10
RATE_LIMITER_ENABLED=false

# How many reverse proxies sit between the internet and this binary. Leave at 0
# when it is directly exposed. Set it to 1 behind a single Traefik/Caddy/Coolify,
# 2 with a CDN in front of that — otherwise every user shares one rate limit
# bucket. Overestimating is harmless, underestimating is not: see the
# "Identification du client derrière un proxy" section of docs/ARCHITECTURE.md.
TRUSTED_PROXY_COUNT=0

# HSTS lifetime in seconds; 0 disables the header. Only ever sent over HTTPS,
# so a plain-HTTP install ignores it.
HSTS_MAX_AGE=31536000

# Let feed and article fetches reach private/loopback addresses. Off by default:
# these URLs come from users, so an unrestricted fetch is an SSRF into whatever
# the server can reach. Turn it on to subscribe to a feed on your LAN or in a
# neighbouring container. Cloud metadata stays blocked either way.
FETCH_ALLOW_PRIVATE_NETWORKS=false

# Anti-bot article fetching (see docs/ANTIBOT_FETCHING.md).
# RSS polling always uses the stdlib client; these only affect article scraping.

# Impersonate a browser TLS/HTTP2 fingerprint when scraping articles.
# Enabled by default; set to false to fall back to the stdlib client.
TLS_IMPERSONATE_ENABLED=true

# FlareSolverr-compatible browser sidecar, for sites requiring JS challenge
# execution. Empty (default) disables browser escalation. To enable it, start
# the `solver` profile of the root docker-compose.yml (Byparr) and uncomment:
#   docker compose --profile solver up -d
# SOLVER_URL="http://solver:8191/v1"
# SOLVER_TIMEOUT="60s"
# SOLVER_MAX_PER_FEED=5

# --- Read by docker-compose.yml only; the binary ignores these ---

# Image tag pulled for the app service. `latest` follows master, `dev` follows
# develop; pin a version tag (v1.2.3) for a real install, since pulling a newer
# image applies its migrations on the next start and they only go one way.
# SIGNET_TAG=latest