# Environment variables for application
PORT=8000
ENV="development"

# Database connection string
DATABASE_URI="postgres://signet:signet@db:5432/signet?sslmode=disable"
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=25
DATABASE_MAX_IDLE_TIME="15m"

# Rate limiter settings
RATE_LIMITER_RPS=5
RATE_LIMITER_BURST=10
RATE_LIMITER_ENABLED=true

# Anti-bot article fetching (see docs/ANTIBOT_FETCHING.md).
# RSS polling always uses the stdlib client; these only affect article scraping.

# Impersonate a browser TLS/HTTP2 fingerprint when scraping articles.
# Enabled by default; set to false to fall back to the stdlib client.
TLS_IMPERSONATE_ENABLED=true

# FlareSolverr-compatible browser sidecar, for sites requiring JS challenge
# execution. Empty (default) disables browser escalation. To enable it, start
# the `solver` profile of the root docker-compose.yml (Byparr) and uncomment:
#   docker compose --profile solver up -d
# SOLVER_URL="http://solver:8191/v1"
# SOLVER_TIMEOUT="60s"
# SOLVER_MAX_PER_FEED=5