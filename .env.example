# Environment variables for application
PORT=8000
ENV="development"

# Database connection string.
DATABASE_URL="postgres://signet:signet@db:5432/signet?sslmode=disable"
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=25
DATABASE_MAX_IDLE_TIME="15m"

# Apply pending migrations on startup. On by default, so a fresh install only
# needs DATABASE_URL. Set to false to advance the schema yourself instead, with
# `./api --migrate-only` or the `make migrate-*` targets — worth doing if you
# run more than one instance and deploy them in a rolling fashion.
AUTO_MIGRATE=true

# Feed sync: poll period, worker pool size, feeds claimed per tick.
SCHEDULER_INTERVAL="15m"
SCHEDULER_WORKERS=5
SCHEDULER_BATCH_SIZE=50

# Rate limiter settings
RATE_LIMITER_RPS=5
RATE_LIMITER_BURST=10
RATE_LIMITER_ENABLED=false

# Anti-bot article fetching (see docs/ANTIBOT_FETCHING.md).
# RSS polling always uses the stdlib client; these only affect article scraping.

# Impersonate a browser TLS/HTTP2 fingerprint when scraping articles.
# Enabled by default; set to false to fall back to the stdlib client.
TLS_IMPERSONATE_ENABLED=true

# FlareSolverr-compatible browser sidecar, for sites requiring JS challenge
# execution. Empty (default) disables browser escalation. To enable it, start
# the `solver` profile of the root docker-compose.yml (Byparr) and uncomment:
#   docker compose --profile solver up -d
# SOLVER_URL="http://solver:8191/v1"
# SOLVER_TIMEOUT="60s"
# SOLVER_MAX_PER_FEED=5

# --- Read by docker-compose.yml only; the binary ignores these ---

# Image tag pulled for the app service. `latest` follows master, `dev` follows
# develop; pin a version tag (v1.2.3) for a real install, since pulling a newer
# image applies its migrations on the next start and they only go one way.
# SIGNET_TAG=latest