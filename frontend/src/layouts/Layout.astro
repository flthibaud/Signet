---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Omnivore", description = "Read-it-later app with RSS support" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141718" />
    <title>{title}</title>
  </head>
  <body class="bg-[#141718] font-sans text-base leading-6 -tracking-[.01em] text-[#141718] antialiased dark:text-[#FEFEFE] dark:md:bg-[#232627]">
    <slot />
  </body>
</html>
