---
import DashboardLayout from "@/layouts/DashboardLayout.astro"
import { Link } from "@/components/Links/Link"
---

<DashboardLayout>
  <div class="flex flex-col h-full">
    <div class="flex justify-between items-center px-10 py-6 border-gray-700 border-b 2xl:py-4 md:px-4 shrink-0">
      <div>
        <input type="checkbox" name="rss-toggle" id="rss-toggle">
      </div>

      <div>
        <span class="text-black text-xs dark:text-white">1-50 sur 2 321</span>
      </div>
    </div>

    <div
      class="grow px-10 py-20 overflow-y-auto scroll-smooth scrollbar-none 2xl:py-12 md:px-4 md:pt-0 md:pb-6"
    >
      <Link client:load />
    </div>

  </div>
</DashboardLayout>
