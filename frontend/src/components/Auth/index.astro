---
import { Image } from 'astro:assets';
import CreatePicImage from '../../assets/create-pic.png';
import AuthForm from './Form';
---

<div
  class="relative flex min-h-screen min-h-screen-ios"
>
  <div
    class="relative shrink-0 w-120 p-10 overflow-hidden hidden lg:block 2xl:w-160"
  >
    <div class="max-w-[25.4rem]">
      <h2 class="mb-4">Unlock the power of RSS</h2>
      <p class="text-[rgba(232,236,239,0.5)] text-2xl font-karla">
        Never miss an article again — save, organize, and read later
      </p>
    </div>
    <div class="absolute top-64 left-5 right-5 h-200">
      <Image
        class="object-contain"
        src={CreatePicImage}
        sizes="(max-width: 1180px) 50vw, 33vw"
        alt=""
      />
    </div>
  </div>
  <div
    class="flex flex-col items-center grow bg-white m-0 p-10 dark:bg-[#232627] md:my-6 md:mx-6 md:rounded-[1.25rem]"
  >
    <a class="flex w-[11.88rem] max-w-47.5 mx-auto mb-8" href="/">
      <img class="w-full h-auto dark:hidden" src="/images/logo-dark.svg" width="190" height="40" alt="Omnivore" />
      <img class="w-full h-auto hidden dark:block" src="/images/logo.svg" width="190" height="40" alt="Omnivore" />
    </a>
    <AuthForm client:load />
  </div>
  <a
    class="group absolute top-12 right-12 flex justify-center items-center w-10 h-10 bg-[#F3F5F7] rounded-full text-0 transition-colors hover:bg-[#0084FF]"
    href="/"
  >
    <svg class="text-[#343839] transition-colors group-hover:text-[#FEFEFE]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </a>
</div>
